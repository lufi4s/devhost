# ---------------------------------------------------------------------------
# Developer Hosting Platform — environment template (Phase 1)
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# App
APP_NAME="Developer Hosting Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000

# Backend / API
BACKEND_URL=
SANCTUM_SERVICE_DOMAIN=localhost
API_URL=

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_DATABASE=devhost
DB_USERNAME=devhost
DB_PASSWORD=devhost_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Queue
QUEUE_CONNECTION=redis
QUEUE_RETRY_AFTER=90
QUEUE_MAX_ATTEMPTS=16

# Node Agent (Phase 9). Phase 1 provisioning is simulated in-process.
AGENT_API_KEY=
AGENT_URL=http://agent:8787

# SSL / DNS (Phase 2+)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
SSL_MODE=manual   # manual | auto

# Backups (Phase 7)
BACKUP_DRIVER=local   # local | s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
